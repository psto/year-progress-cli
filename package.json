{
  "name": "year-progress-cli",
  "version": "1.1.0",
  "description": "A command line tool for displaying year progress.",
  "main": "dist/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "keywords": [
    "year progress",
    "cli",
    "cli app"
  ],
  "author": {
    "name": "Piotr Stojanow",
    "email": "piotrstojanow@gmail.com",
    "url": "stojanow.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/psto/year-progress-cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/psto/year-progress-cli.git"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "unbuild",
    "dev": "npm run build && node bin/year-progress.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "year-progress": "bin/year-progress.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.6"
  }
}
